{
  "name": "IMPI MCP - Consulta Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "impi-consulta",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://TU-HOST:3000/api/disponibilidad",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.IMPI_MCP_API_KEY }}" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"nombre\": \"{{ $json.body.nombre }}\",\n  \"clases\": {{ JSON.stringify($json.body.clases ?? [30,35]) }}\n}",
        "options": {}
      },
      "id": "http-1",
      "name": "Consultar IMPI MCP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "resp-1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Consultar IMPI MCP", "type": "main", "index": 0 }]] },
    "Consultar IMPI MCP": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "notesInFlow": true, "description": "Recibe {nombre, clases[]} → dictamen de disponibilidad del servidor MCP IMPI." }
}
