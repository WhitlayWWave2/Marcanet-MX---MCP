{
  "name": "impi-mcp",
  "version": "2.0.0",
  "description": "Servidor MCP + API HTTP + worker autónomo para consultar el Acervo de Marcas del IMPI (México). Funciona SIN LLM: n8n, cron o cualquier cliente REST pueden usarlo.",
  "type": "module",
  "main": "build/server.js",
  "bin": { "impi-mcp": "build/server.js" },
  "scripts": {
    "build": "tsc",
    "dev:server": "tsx src/server.ts",
    "dev:api": "tsx src/http-api.ts",
    "dev:worker": "tsx src/worker.ts",
    "start:server": "node build/server.js",
    "start:api": "node build/http-api.js",
    "start:worker": "node build/worker.js",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bullmq": "^5.44.0",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "playwright": "^1.51.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=20" }
}
