{
  "name": "impi-mcp",
  "version": "2.0.0",
  "description": "Servidor MCP + API HTTP + worker autónomo para consultar el Acervo de Marcas del IMPI (México). Funciona SIN LLM: n8n, cron o cualquier cliente REST pueden usarlo.",
  "type": "module",
  "main": "build/server.js",
  "bin": {
    "impi-mcp": "build/server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev:server": "tsx src/server.ts",
    "dev:api": "tsx src/http-api.ts",
    "dev:worker": "tsx src/worker.ts",
    "start:server": "node build/server.js",
    "start:api": "node build/http-api.js",
    "start:worker": "node build/worker.js",
    "smoke": "tsx scripts/smoke.ts",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bullmq": "^5.44.0",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "playwright": "^1.51.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build",
    "scrape-profile.json",
    "n8n",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "impi",
    "marcas",
    "méxico",
    "trademarks",
    "scraper",
    "n8n",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhitlayWWave2/Marcanet-MX---MCP.git"
  },
  "homepage": "https://github.com/WhitlayWWave2/Marcanet-MX---MCP#readme"
}